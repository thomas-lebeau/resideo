# Rename this file to terraform.tfvars and fill in your actual values

# Datadog API credentials (required)
# Get these from Organization Settings > API Keys / Application Keys on your Datadog site,
# e.g. https://app.datadoghq.com/organization-settings/api-keys
datadog_api_key = "your-datadog-api-key-here"
datadog_app_key = "your-datadog-app-key-here"

# Datadog site (optional, defaults to datadoghq.com)
# Use the same value as the app's DD_SITE, e.g. datadoghq.eu for EU
# datadog_site = "datadoghq.com"
