# Datadog credentials used by the /api/query handler (server-side only, never sent to the browser).
# Leave the keys empty to run with generated mock data.
DD_API_KEY=
# Application key with the timeseries_query scope: https://app.datadoghq.com/organization-settings/application-keys
DD_APP_KEY=
DD_SITE=datadoghq.com # datadoghq.eu for EU
# Optional tag scope applied to every query, e.g. env:production. Defaults to *.
DD_QUERY_SCOPE=*
